+
+type connIDTracer struct {
+	mx      sync.Mutex
+	active  map[quic.ConnectionID]struct{}
+	added   int
+	removed int
+}
+
+func newConnIDTracer(t *testing.T, isClient bool) (*connIDTracer, func(context.Context, bool, quic.ConnectionID) *quic.ConnectionIDTracer) {
+	tr := &connIDTracer{active: make(map[quic.ConnectionID]struct{})}
+	return tr, func(_ context.Context, client bool, _ quic.ConnectionID) *quic.ConnectionIDTracer {
+		assert.Equal(t, isClient, client)
+		return &quic.ConnectionIDTracer{
+			AddedConnectionID: func(id quic.ConnectionID) {
+				tr.mx.Lock()
+				defer tr.mx.Unlock()
+				_, ok := tr.active[id]
+				assert.False(t, ok, "connection ID %s added twice", id)
+				tr.active[id] = struct{}{}
+				tr.added++
+			},
+			RemovedConnectionID: func(id quic.ConnectionID) {
+				tr.mx.Lock()
+				defer tr.mx.Unlock()
+				_, ok := tr.active[id]
+				assert.True(t, ok, "connection ID %s removed but not active", id)
+				delete(tr.active, id)
+				tr.removed++
+			},
+		}
+	}
+}
+
+func (tr *connIDTracer) isActive(id quic.ConnectionID) bool {
+	tr.mx.Lock()
+	defer tr.mx.Unlock()
+	_, ok := tr.active[id]
+	return ok
+}
+
+func TestConnectionIDTracer(t *testing.T) {
+	serverIDs, serverTracer := newConnIDTracer(t, false)
+	clientIDs, clientTracer := newConnIDTracer(t, true)
+
+	// Every short header packet that is received must use an active connection ID.
+	// Check this when the packet is received, since connection IDs are retired during the transfer.
+	checkReceived := func(ids *connIDTracer) func(context.Context, bool, quic.ConnectionID) qlogwriter.Trace {
+		return newTracer(&recordFunc{fn: func(ev qlogwriter.Event) {
+			if e, ok := ev.(qlog.PacketReceived); ok && e.Header.PacketType == qlog.PacketType1RTT {
+				assert.True(t, ids.isActive(e.Header.DestConnectionID), "received packet for inactive connection ID %s", e.Header.DestConnectionID)
+			}
+		}})
+	}
+
+	serverTr := &quic.Transport{Conn: newUDPConnLocalhost(t), ConnectionIDLength: 8}
+	defer serverTr.Close()
+	ln, err := serverTr.Listen(getTLSConfig(), getQuicConfig(&quic.Config{
+		ConnectionIDTracer: serverTracer,
+		Tracer:             checkReceived(serverIDs),
+	}))
+	require.NoError(t, err)
+	defer ln.Close()
+
+	clientTr := &quic.Transport{Conn: newUDPConnLocalhost(t), ConnectionIDLength: 8}
+	defer clientTr.Close()
+	ctx, cancel := context.WithTimeout(context.Background(), scaleDuration(10*time.Second))
+	defer cancel()
+	conn, err := clientTr.Dial(ctx, ln.Addr(), getTLSClientConfig(), getQuicConfig(&quic.Config{
+		ConnectionIDTracer: clientTracer,
+		Tracer:             checkReceived(clientIDs),
+	}))
+	require.NoError(t, err)
+	serverConn, err := ln.Accept(ctx)
+	require.NoError(t, err)
+
+	// Transfer enough data that the server switches to new connection IDs (see protocol.PacketsPerConnectionID),
+	// which makes the client retire old and issue new connection IDs.
+	go func() {
+		str, err := serverConn.OpenUniStream()
+		if !assert.NoError(t, err) {
+			return
+		}
+		str.Write(PRDataLong)
+		str.Close()
+	}()
+	str, err := conn.AcceptUniStream(ctx)
+	require.NoError(t, err)
+	data, err := io.ReadAll(str)
+	require.NoError(t, err)
+	require.Equal(t, PRDataLong, data)
+
+	clientIDs.mx.Lock()
+	require.Greater(t, clientIDs.added, protocol.MaxIssuedConnectionIDs)
+	clientIDs.mx.Unlock()
+
+	conn.CloseWithError(0, "")
+	select {
+	case <-serverConn.Context().Done():
+	case <-time.After(scaleDuration(time.Second)):
+		t.Fatal("timeout")
+	}
+	for _, ids := range []*connIDTracer{clientIDs, serverIDs} {
+		ids.mx.Lock()
+		require.Empty(t, ids.active)
+		require.Equal(t, ids.added, ids.removed)
+		ids.mx.Unlock()
+	}
+}
+
+type recordFunc struct{ fn func(qlogwriter.Event) }
+
+func (r *recordFunc) RecordEvent(ev qlogwriter.Event) { r.fn(ev) }
+func (r *recordFunc) Close() error                    { return nil }
diff --git a/interface.go b/interface.go
index db942ac9..46bb7e53 100644
--- a/interface.go
+++ b/interface.go
@@ -190,6 +190,36 @@ type Config struct {
 	EnableStreamResetPartialDelivery bool
 
 	Tracer func(ctx context.Context, isClient bool, connID ConnectionID) qlogwriter.Trace
+	// ConnectionIDTracer is called once for every new connection,
+	// with the same arguments as the Tracer.
+	// The returned ConnectionIDTracer (which may be nil) is notified about the lifecycle
+	// of the connection IDs that the Transport uses to route packets to this connection.
+	// Unlike the Tracer, it doesn't cause any per-packet work.
+	ConnectionIDTracer func(ctx context.Context, isClient bool, connID ConnectionID) *ConnectionIDTracer
+}
+
+// A ConnectionIDTracer is notified when local connection IDs start and stop being
+// associated with a connection, i.e. it observes the changes the connection makes to
+// the Transport's routing table. This is useful for applications that demultiplex
+// packets themselves, for example when wrapping a net.PacketConn that is shared with
+// other protocols or connections.
+//
+// For a single connection, the callbacks are never called concurrently,
+// but callbacks for different connections may be.
+// The callbacks must not block, and they must not call any methods on the connection.
+type ConnectionIDTracer struct {
+	// AddedConnectionID is called when a connection ID is associated with the connection.
+	// This happens for the connection IDs used during the handshake, and for every
+	// connection ID issued in a NEW_CONNECTION_ID frame.
+	// It is called before the connection ID is sent to the peer.
+	AddedConnectionID func(ConnectionID)
+	// RemovedConnectionID is called when a connection ID is not associated with the
+	// connection any more: some time (3 PTOs) after the peer retired it, or when the
+	// connection is closed. It is called exactly once for every connection ID passed
+	// to AddedConnectionID.
+	// After a connection is closed, the Transport might still respond to packets
+	// using this connection ID for a short while.
+	RemovedConnectionID func(ConnectionID)
 }
 
 // ClientInfo contains information about an incoming connection attempt.
