+func TestConnIDGeneratorTracer(t *testing.T) {
+	t.Run("replaced with closed", func(t *testing.T) {
+		testConnIDGeneratorTracer(t, false)
+	})
+	t.Run("removed", func(t *testing.T) {
+		testConnIDGeneratorTracer(t, true)
+	})
+}
+
+func testConnIDGeneratorTracer(t *testing.T, removeAll bool) {
+	initialConnID := protocol.ParseConnectionID([]byte{1, 1, 1, 1})
+	initialClientDestConnID := protocol.ParseConnectionID([]byte{2, 2, 2, 2})
+	var (
+		runnerAdded  []protocol.ConnectionID
+		traceAdded   []protocol.ConnectionID
+		traceRemoved []protocol.ConnectionID
+		queuedFrames []wire.Frame
+	)
+	g := newConnIDGenerator(
+		&packetHandlerMap{},
+		initialConnID,
+		&initialClientDestConnID,
+		newStatelessResetter(&StatelessResetKey{1, 2, 3, 4}),
+		connRunnerCallbacks{
+			AddConnectionID:    func(c protocol.ConnectionID) { runnerAdded = append(runnerAdded, c) },
+			RemoveConnectionID: func(protocol.ConnectionID) {},
+			ReplaceWithClosed:  func([]protocol.ConnectionID, []byte, time.Duration) {},
+		},
+		func(f wire.Frame) {
+			// the connection ID must be traced before it is sent to the peer
+			require.Contains(t, traceAdded, f.(*wire.NewConnectionIDFrame).ConnectionID)
+			queuedFrames = append(queuedFrames, f)
+		},
+		&protocol.DefaultConnectionIDGenerator{ConnLen: 5},
+		&ConnectionIDTracer{
+			AddedConnectionID:   func(c protocol.ConnectionID) { traceAdded = append(traceAdded, c) },
+			RemovedConnectionID: func(c protocol.ConnectionID) { traceRemoved = append(traceRemoved, c) },
+		},
+	)
+	// the connection IDs used during the handshake are reported immediately
+	require.Equal(t, []protocol.ConnectionID{initialClientDestConnID, initialConnID}, traceAdded)
+
+	require.NoError(t, g.SetMaxActiveConnIDs(4))
+	require.Len(t, queuedFrames, 3)
+	require.Equal(t, runnerAdded, traceAdded[2:])
+
+	// retired connection IDs are only removed after the expiry
+	now := monotime.Now()
+	require.NoError(t, g.Retire(1, initialConnID, now.Add(time.Second)))
+	require.Len(t, traceAdded, 6) // the retired connection ID is replaced
+	g.SetHandshakeComplete(now.Add(time.Second))
+	g.RemoveRetiredConnIDs(now)
+	require.Empty(t, traceRemoved)
+	g.RemoveRetiredConnIDs(now.Add(time.Second))
+	require.ElementsMatch(t, []protocol.ConnectionID{initialClientDestConnID, traceAdded[2]}, traceRemoved)
+
+	// all remaining connection IDs are removed when the connection is closed
+	if removeAll {
+		g.RemoveAll()
+	} else {
+		g.ReplaceWithClosed([]byte("foobar"), time.Second)
+	}
+	require.ElementsMatch(t, traceAdded, traceRemoved)
+}
+
+func TestConnIDGeneratorTracerWithoutCallbacks(t *testing.T) {
+	g := newConnIDGenerator(
+		&packetHandlerMap{},
+		protocol.ParseConnectionID([]byte{1, 1, 1, 1}),
+		nil,
+		newStatelessResetter(&StatelessResetKey{1, 2, 3, 4}),
+		connRunnerCallbacks{
+			AddConnectionID:    func(protocol.ConnectionID) {},
+			RemoveConnectionID: func(protocol.ConnectionID) {},
+			ReplaceWithClosed:  func([]protocol.ConnectionID, []byte, time.Duration) {},
+		},
+		func(wire.Frame) {},
+		&protocol.DefaultConnectionIDGenerator{ConnLen: 5},
+		&ConnectionIDTracer{},
+	)
+	require.NoError(t, g.SetMaxActiveConnIDs(4))
+	g.RemoveAll()
+}
